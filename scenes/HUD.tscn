[node name="Body" type="Label" parent="Control/Center/LoreModal/VBox"]
custom_minimum_size = Vector2(520, 190)
layout_mode = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "«Коли небо впало, а перша імперія потонула в чорному попелі, Вартові склали нерозривну клятву крові. Тіла їхні були замуровані в граніт крипти, а душі зв'язані печатками Мор-Гула.\n\nТи — останній Могилонароджений (Gravebound). Пробуджений із праху, коли древня печать тріснула, ти ступаєш цим холодним камінням. Твій меч жадає спокою для тих, чиї кістки були підняті скверною...\n\nЗнищ вартових та розбуди потаємний прохід у глибини катакомб!»"
autowrap_mode = 2

[node name="CloseButton" type="Button" parent="Control/Center/LoreModal/VBox"]
