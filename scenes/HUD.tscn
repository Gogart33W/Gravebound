[node name="Body" type="Label" parent="Control/Center/LoreModal/VBox"]
custom_minimum_size = Vector2(500, 180)
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.9, 0.88, 0.82, 1)
theme_override_font_sizes/font_size = 14
text = "«Коли небо впало, а перша імперія потонула в чорному попелі, Вартові склали нерозривну клятву крові. Тіла їхні були замуровані в граніт крипти, а душі зв'язані печатками Мор-Гула.\n\nТи — останній Могилонароджений (Gravebound). Пробуджений із праху, коли древня печать тріснула, ти ступаєш цим холодним камінням. Твій меч жадає спокою для тих, чиї кістки були підняті скверною...»"
autowrap_mode = 2

[node name="CloseHint" type="Label" parent="Control/Center/LoreModal/VBox"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.6, 0.6, 0.6, 1)
theme_override_font_sizes/font_size = 12
text = "[Натисніть 'E', 'L' або Esc для закриття хроніки]"
horizontal_alignment = 1

