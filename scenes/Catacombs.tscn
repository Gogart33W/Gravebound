[node name="Catacombs" type="Node3D"]
script = ExtResource("1_manager")
ChapterTitle = "Розділ II: Катакомби Мор-Гула"
CompletedTitle = "Розділ II: Архімага Мор-Гула подолано!"
VictoryTitle = "«ЛЕГЕНДА МОГИЛОНАРОДЖЕНОГО»"
VictoryBody = "Древній Архімаг Мор-Гул та його поплічники полягли під твоїм мечем!\n\nТи розбив печать скверни, очистив глибини Катакомб і закарбував своє ім'я у легендах.\n\nДемо-версію успішно пройдено! Дякуємо за гру!"
VictoryButton = "ПОВЕРНУТИСЯ ДО СКЛЕПУ"
NextScenePath = "res://scenes/Main.tscn"

